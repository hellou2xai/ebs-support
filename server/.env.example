# Copy this file to .env and fill in your key.
#   Windows PowerShell:  Copy-Item .env.example .env
#   then edit .env and paste your key.

# Your Anthropic API key. Get one at https://console.anthropic.com/settings/keys
# Leave blank to run the demo in OFFLINE mode (deterministic agent, no API calls).
ANTHROPIC_API_KEY=

# Model used for live classification and narration.
# Options: claude-opus-4-8 (most capable), claude-sonnet-4-6 (faster), claude-haiku-4-5-20251001 (fastest)
CLAUDE_MODEL=claude-sonnet-4-6

# Backend port
PORT=8787

# Path to the data folder (defaults to ../data relative to the server folder)
# DATA_DIR=../data
